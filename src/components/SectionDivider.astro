---
interface Props {
  number: string;
  label: string;
  title?: string;
  background?: string;
}

const { number, label, title, background = 'transparent' } = Astro.props;
---

<div
  class="section-divider-wrap"
  style={`background-color: ${background};`}
  aria-hidden="true"
>
  <div class="section-divider-line"></div>
  <div class="section-divider-badge">
    <span class="emblem">✦</span>
    <span>{number} &bull; {label}</span>
    {title && <span style="color: var(--color-text-muted); font-weight: 400;">/ {title}</span>}
    <span class="emblem">✦</span>
  </div>
</div>
